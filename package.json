{
  "name": "hermes-agent-campus",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "A privacy-first ProjectContext to RoomSpec engine and shared 3D campus runtime for agent teams.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate": "node scripts/campus.mjs generate",
    "validate": "node scripts/campus.mjs validate-all",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run validate && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "three": "^0.180.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.3"
  },
  "engines": { "node": ">=20" }
}
