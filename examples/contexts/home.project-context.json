{
  "schema_version": "1.0.0",
  "id": "home",
  "display_name": "Home",
  "summary": "A warm late-afternoon living room that acts as the calm entrypoint to Campus.",
  "allowed_sources": [
    "README.md",
    "notes/design-lock.md",
    "notes/projects.md"
  ],
  "privacy": {
    "excluded_sources": [
      ".env",
      "private/",
      "personal/"
    ],
    "prohibited_output_classes": [
      "secrets",
      "credentials",
      "personal-paths",
      "client-data",
      "unrelated-memory"
    ]
  },
  "visual_identity": {
    "keywords": [
      "home",
      "warm",
      "late-afternoon",
      "oak"
    ],
    "colors": [
      "#e6d4bb",
      "#cbb89d",
      "#b6794d",
      "#765540",
      "#b8563e",
      "#7b8f78"
    ],
    "materials": [
      "oak boards",
      "warm mineral plaster",
      "linen upholstery"
    ],
    "architecture_hint": "residential L-shaped living room with layered trim",
    "lighting_hint": "late-afternoon sun plus warm practical lamps",
    "openings_hint": "two deep-framed house windows",
    "hero_feature": "glowing hearth and library corner",
    "pet": "house cat"
  },
  "agents": [
    {
      "handle": "general-assistant",
      "role": "home orchestrator",
      "team_member": true
    }
  ],
  "jobs": [
    {
      "name": "home-weekly-review",
      "owner": "general-assistant",
      "schedule": "Sunday 17:00 local",
      "enabled": true
    }
  ]
}
