{
  "schema_version": "1.0.0",
  "id": "wanderpick",
  "display_name": "WanderPick",
  "summary": "A local-adventure discovery product powered by the live Google Places API, with no crawling and no local places index.",
  "allowed_sources": [
    "README.md",
    "notes/design-lock.md",
    "notes/projects.md"
  ],
  "privacy": {
    "excluded_sources": [
      ".env",
      "user-location-history/",
      "private-itineraries/"
    ],
    "prohibited_output_classes": [
      "secrets",
      "credentials",
      "client-data",
      "personal-paths",
      "unrelated-memory"
    ]
  },
  "visual_identity": {
    "keywords": [
      "sky",
      "postcard",
      "local-adventure",
      "afternoon"
    ],
    "colors": [
      "#d7e9ed",
      "#eef3e9",
      "#72a9b9",
      "#e2a95f",
      "#e6664f",
      "#456b5d"
    ],
    "materials": [
      "painted wood",
      "chalky sky plaster",
      "canvas and paper"
    ],
    "architecture_hint": "postcard loft with a single panoramic map window",
    "lighting_hint": "clear afternoon sun with sky-blue fill",
    "openings_hint": "one panoramic map-window with daybed",
    "hero_feature": "interactive map window and packed day-trip kit",
    "pet": "map fox"
  },
  "agents": [
    {
      "handle": "wanderpick",
      "role": "product orchestrator",
      "team_member": true
    },
    {
      "handle": "place-curator",
      "role": "experience builder",
      "team_member": true
    },
    {
      "handle": "trip-reviewer",
      "role": "quality reviewer",
      "team_member": true
    }
  ],
  "jobs": [
    {
      "name": "wanderpick-place-health",
      "owner": "wanderpick",
      "schedule": "Weekdays 10:00 local",
      "enabled": true
    }
  ]
}
