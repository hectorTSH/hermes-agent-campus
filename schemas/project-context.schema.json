{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent-campus.dev/schemas/project-context/v1.json",
  "title": "ProjectContext v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "summary", "allowed_sources", "privacy", "visual_identity", "agents", "jobs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
    "summary": {"type": "string", "minLength": 1, "maxLength": 600},
    "allowed_sources": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^(?!/|~|.*\\.\\.).+"}},
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["excluded_sources", "prohibited_output_classes"],
      "properties": {
        "excluded_sources": {"type": "array", "items": {"type": "string", "maxLength": 160}},
        "prohibited_output_classes": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["secrets", "credentials", "wallet-material", "phi", "client-data", "personal-paths", "unrelated-memory", "raw-model-payloads"]}}
      }
    },
    "visual_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["keywords", "colors", "materials", "architecture_hint", "lighting_hint", "openings_hint", "hero_feature", "pet"],
      "properties": {
        "keywords": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"type": "string", "maxLength": 40}},
        "colors": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
        "materials": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "maxLength": 40}},
        "architecture_hint": {"type": "string", "maxLength": 160},
        "lighting_hint": {"type": "string", "maxLength": 160},
        "openings_hint": {"type": "string", "maxLength": 160},
        "hero_feature": {"type": "string", "maxLength": 120},
        "pet": {"type": "string", "maxLength": 60}
      }
    },
    "agents": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["handle", "role", "team_member"], "properties": {"handle": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,47}$"}, "role": {"type": "string", "maxLength": 60}, "team_member": {"type": "boolean"}}}},
    "jobs": {"type": "array", "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["name", "owner", "schedule", "enabled"], "properties": {"name": {"type": "string", "maxLength": 80}, "owner": {"type": "string"}, "schedule": {"type": "string", "maxLength": 80}, "enabled": {"type": "boolean"}}}}
  }
}
